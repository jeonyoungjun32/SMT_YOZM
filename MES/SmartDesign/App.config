<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
    </configSections>
    <connectionStrings>
        <add name="SmartDesign.Properties.Settings.MESDBConnectionString"
            connectionString="Data Source=smtv.iptime.org,2433;Initial Catalog=SNexis_MES;Persist Security Info=True;User ID=smtv;Password=YOUR_DB_PASSWORD"
            providerName="System.Data.SqlClient" />
